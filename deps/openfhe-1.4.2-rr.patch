+// RR_CLEAN_DECODE=1: decrypt WITHOUT the production decode's 2^p renormalization.
+//
+// `CKKSPackedEncoding::Decode`'s multi-tower branch brings the scaling factor down through
+// 2^p with p = GetPlaintextModulus() = the context's scalingModSize (25), which costs ~16.7
+// bits REGARDLESS of the chain's real 2^40/2^55 scales (measured: the round trip tracks
+// scalingModSize 1:1). Every stage value printed by the trace has therefore been read through
+// a 16.7-bit instrument, and at pre-cheby — where the ciphertext carries the I lattice at
+// magnitude ~0.3 — that alone accounts for a lattice residual of ~9e-5 against the ~1.1e-4
+// observed. So the trace could not distinguish "CoeffsToSlots injected noise" from "the decode
+// could not see it".
+//
+// This path CRT-interpolates, centers, divides by the ciphertext's ACTUAL scaling factor and
+// runs FFTSpecial — the same steps, minus the renormalization — so it is limited by double
+// precision (~50 bits) instead. Slow (a BigInteger reconstruction per coefficient), diagnostic only.
+static bool rrCleanDecode(ConstCiphertext<DCRTPoly>& ct, uint32_t slots,
+                          std::vector<std::complex<double>>& out) {
+    const auto& cv = ct->GetElements();
+    if (cv.size() != 2 || !g_rrTraceKey)
+        return false;
+    DCRTPoly s      = (*g_rrTraceKey)->GetPrivateElement();
+    const auto& ctP = cv[0].GetParams()->GetParams();
+    const auto& sP  = s.GetParams()->GetParams();
+    DCRTPoly sr(cv[0].GetParams(), EVALUATION, true);
+    for (size_t j = 0; j < ctP.size(); ++j) {
+        size_t i = 0;
+        for (; i < sP.size(); ++i)
+            if (sP[i]->GetModulus() == ctP[j]->GetModulus())
