From 4ae6972c4ad0dcf1ffd863f245807bd2fa70bfee Mon Sep 17 00:00:00 2001
From: dev <dev@behemoth>
Date: Sat, 1 Aug 2026 13:14:07 +0200
Subject: [PATCH 02/21] Rational-rescaling chain (Cheddar 25-30): explicit
 prime schedule, windowed levels, drop-k+add-back rescale

- CCParams::SetRRPrimeChain/SetRRWindows/SetRRNumSmalls: explicit prime
  identities in inverted-terminal layout order + per-level contiguous
  windows; ParamsGen fills moduliQ from the chain (FLEXIBLEAUTO only) and
  asserts the 128-bit logPQ budget (1746) at N=2^16.
- PrecomputeCRTTables: RR scaling-factor table indexed by rescale count
  (not limbs dropped), exact per-level F = prod(drop)/prod(add), region
  boundary reset (mixedlimb convention).
- RRChain (ckksrns-rr.{h,cpp}): per-level params via GetParamPartition,
  RR rescale = scalar mult by prod(added) (zero residues on the incoming
  primes make the add-back a zero-extension) + sequential centered-lift
  exact division by the dropped primes; window-restricted encrypt/decrypt/
  encode helpers for driving the chain.
---
 src/pke/include/scheme/ckksrns/ckksrns-rr.h   |  77 ++++++
 .../gen-cryptocontext-ckksrns-internal.h      |   3 +
 .../include/scheme/gen-cryptocontext-params.h |  29 +++
 .../include/schemerns/rns-cryptoparameters.h  |  30 +++
 .../ckksrns/ckksrns-cryptoparameters.cpp      |  36 ++-
 .../ckksrns/ckksrns-parametergeneration.cpp   |  64 ++++-
 src/pke/lib/scheme/ckksrns/ckksrns-rr.cpp     | 231 ++++++++++++++++++
 7 files changed, 468 insertions(+), 2 deletions(-)
 create mode 100644 src/pke/include/scheme/ckksrns/ckksrns-rr.h
 create mode 100644 src/pke/lib/scheme/ckksrns/ckksrns-rr.cpp

diff --git a/src/pke/include/scheme/ckksrns/ckksrns-rr.h b/src/pke/include/scheme/ckksrns/ckksrns-rr.h
new file mode 100644
index 00000000..d57710fa
--- /dev/null
+++ b/src/pke/include/scheme/ckksrns/ckksrns-rr.h
@@ -0,0 +1,77 @@
+//==================================================================================
+// Rational-rescaling (Cheddar 25-30 prime system) chain support.
+//
+// The RR chain gives every level an explicit prime SET (a contiguous window of
+// the inverted-terminal layout carried in CCParams::rrPrimeChain), and rescale
+// becomes a modulus switch by prod(dropped)/prod(added): multiply by the scalar
+// prod(added) — whose residues on the incoming primes are exactly zero, so the
+// "add-back base extension" is a zero-extension — then divide out the dropped
+// primes one at a time with the standard centered-lift exact division. No
+// approximate multi-limb CRT switch is ever needed.
+//
+// Ciphertexts on an RR chain store the RESCALE COUNT from the top in m_level
+// (RR levels drop a variable number of limbs and can add limbs back, so limb
+// count does not identify a level). They must be driven through this class, not
+// through ModReduce/LevelReduce.
+//==================================================================================
+#ifndef LBCRYPTO_CRYPTO_CKKSRNS_RR_H
+#define LBCRYPTO_CRYPTO_CKKSRNS_RR_H
+
+#include "cryptocontext.h"
+
+#include <memory>
+#include <vector>
+
+namespace lbcrypto {
+
+struct RRLevel {
+    uint32_t lo, hi;                           // inclusive window into the layout
+    std::shared_ptr<DCRTPoly::Params> params;  // element params of the window
+};
+
+class RRChain {
+public:
+    explicit RRChain(const CryptoContext<DCRTPoly>& cc);
+
+    uint32_t NumLevels() const {
+        return m_levels.size();
+    }
+    const RRLevel& Level(uint32_t r) const {
+        return m_levels.at(r);
+    }
+    uint32_t RRLevelOf(ConstCiphertext<DCRTPoly>& ct) const {
+        return NumLevels() - 1 - ct->GetLevel();
+    }
+    // factor of the rescale rHi -> rHi-1 (= prod(dropped)/prod(added))
+    double RescaleFactor(uint32_t rHi) const {
+        return m_F.at(rHi - 1);
+    }
+
+    // restrict a full-chain element (sk/pk rows) to level r's window
+    DCRTPoly Restrict(const DCRTPoly& full, uint32_t r) const;
+
+    // RR rescale from the ciphertext's level to the one below
+    void RescaleInPlace(Ciphertext<DCRTPoly>& ct) const;
+    DCRTPoly RescaleElement(const DCRTPoly& e, uint32_t rHi) const;
+
+    // encode at level r with an explicit scale (deg-1 by default)
+    Plaintext MakePlaintext(const std::vector<std::complex<double>>& value, uint32_t r, double scale,
+                            size_t noiseScaleDeg = 1, uint32_t slots = 0) const;
+    Ciphertext<DCRTPoly> Encrypt(const PublicKey<DCRTPoly>& pk, const Plaintext& pt, uint32_t r) const;
+    Plaintext Decrypt(const PrivateKey<DCRTPoly>& sk, ConstCiphertext<DCRTPoly>& ct) const;
+
+    // ct x pt product (no relinearization involved); scale/deg bookkeeping included
+    void EvalMultPlainInPlace(Ciphertext<DCRTPoly>& ct, const Plaintext& pt) const;
+    void EvalAddInPlace(Ciphertext<DCRTPoly>& ct1, ConstCiphertext<DCRTPoly>& ct2) const;
+
+private:
+    CryptoContext<DCRTPoly> m_cc;
+    std::vector<uint64_t> m_chain;
+    uint32_t m_S = 0;
+    std::vector<RRLevel> m_levels;
+    std::vector<double> m_F;  // m_F[r-1] = rescale factor r -> r-1
+};
+
+}  // namespace lbcrypto
+
+#endif
