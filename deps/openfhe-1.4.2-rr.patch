+//
+// The hoisted path runs a SINGLE modup (`EvalFastRotationPrecompute`) and dots many rotations
+// against it, accumulating in the extended basis before one `KeySwitchDown`. That shared
+// precompute is the only place in CoeffsToSlots where one rotation's precision depends on work
+// done for a DIFFERENT rotation — which is exactly the kind of defect that survives the
+// component-wise testing every other CtS suspect has now passed.
+//
+// No lattice and no host DFT are needed, because a rotation is just a PERMUTATION of the slot
+// values: decode both sides with the clean decode and find the cyclic shift that matches best.
+// The residual at that shift IS the rotation's error, self-calibrated against the input.
+static void rrRotCheck(const CryptoContext<DCRTPoly>& cc, const char* tag, const Ciphertext<DCRTPoly>& in,
+                       const Ciphertext<DCRTPoly>& ext) {
+    static const bool on = std::getenv("RR_CTS_ROTCHECK") != nullptr;
+    if (!on || !g_rrTraceKey)
