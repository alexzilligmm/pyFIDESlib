+//==================================================================================
+// Rational-rescaling chain support — see ckksrns-rr.h for the model.
+//==================================================================================
+#include "scheme/ckksrns/ckksrns-rr.h"
+
+#include "encoding/ckkspackedencoding.h"
+#include "encoding/plaintextfactory.h"
+#include "scheme/ckksrns/ckksrns-cryptoparameters.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace lbcrypto {
+
+RRChain::RRChain(const CryptoContext<DCRTPoly>& cc) : m_cc(cc) {
+    const auto cryptoParams = std::dynamic_pointer_cast<CryptoParametersCKKSRNS>(cc->GetCryptoParameters());
+    if (cryptoParams == nullptr || !cryptoParams->IsRRChain())
+        OPENFHE_THROW("RRChain: the context does not carry an RR prime chain.");
+    m_chain            = cryptoParams->GetRRPrimeChain();
+    m_S                = cryptoParams->GetRRNumSmalls();
+    const auto& win    = cryptoParams->GetRRWindows();
+    const auto gparams = cryptoParams->GetElementParams();
+    if (gparams->GetParams().size() != m_chain.size())
+        OPENFHE_THROW("RRChain: element params/chain size mismatch.");
+    for (size_t i = 0; i < m_chain.size(); ++i) {
+        if (gparams->GetParams()[i]->GetModulus().ConvertToInt() != m_chain[i])
+            OPENFHE_THROW("RRChain: element params do not match the RR chain layout order.");
+    }
+    size_t nLvl = win.size() / 2;
+    m_levels.resize(nLvl);
+    for (size_t r = 0; r < nLvl; ++r) {
+        uint32_t lo = win[2 * r], hi = win[2 * r + 1];
+        m_levels[r].lo = lo;
+        m_levels[r].hi = hi;
+        m_levels[r].params =
+            std::make_shared<DCRTPoly::Params>(gparams->GetCyclotomicOrder(), gparams->GetParamPartition(lo, hi));
+    }
+    m_F.resize(nLvl - 1);
+    for (size_t r = 1; r < nLvl; ++r) {
+        const auto& H = m_levels[r];
+        const auto& L = m_levels[r - 1];
+        double f      = 1.0;
+        for (uint32_t i = std::min(H.lo, L.lo); i < std::max(H.lo, L.lo); ++i)
+            f = (H.lo < L.lo) ? f * static_cast<double>(m_chain[i]) : f / static_cast<double>(m_chain[i]);
+        for (uint32_t i = std::min(H.hi, L.hi) + 1; i <= std::max(H.hi, L.hi); ++i)
+            f = (H.hi > L.hi) ? f * static_cast<double>(m_chain[i]) : f / static_cast<double>(m_chain[i]);
+        m_F[r - 1] = f;
+    }
+}
+
+DCRTPoly RRChain::Restrict(const DCRTPoly& full, uint32_t r) const {
+    const auto& lvl = Level(r);
+    DCRTPoly out(lvl.params, full.GetFormat(), true);
+    for (uint32_t i = lvl.lo; i <= lvl.hi; ++i)
+        out.SetElementAtIndex(i - lvl.lo, full.GetElementAtIndex(i));
+    return out;
+}
+
+DCRTPoly RRChain::RescaleElement(const DCRTPoly& e, uint32_t rHi) const {
+    if (rHi == 0)
+        OPENFHE_THROW("RRChain: cannot rescale below level 0.");
+    const auto& cur    = Level(rHi);
+    const auto& nxt    = Level(rHi - 1);
+    const auto gparams = m_cc->GetCryptoParameters()->GetElementParams();
+
+    // working set: global-ascending union window [uLo, uHi]
+    uint32_t uLo = std::min(cur.lo, nxt.lo);
+    uint32_t uHi = std::max(cur.hi, nxt.hi);
+
+    std::vector<uint32_t> added, dropped;
+    for (uint32_t i = nxt.lo; i < cur.lo; ++i)
+        added.push_back(i);
+    for (uint32_t i = cur.hi + 1; i <= nxt.hi; ++i)
+        added.push_back(i);
+    for (uint32_t i = cur.lo; i < nxt.lo; ++i)
+        dropped.push_back(i);
+    for (uint32_t i = nxt.hi + 1; i <= cur.hi; ++i)
+        dropped.push_back(i);
+
+    // t = e * prod(added) on the union basis; residues on the added primes are 0.
+    std::vector<uint32_t> gidx;
+    std::vector<DCRTPoly::PolyType> towers;
+    for (uint32_t g = uLo; g <= uHi; ++g) {
+        gidx.push_back(g);
+        if (g >= cur.lo && g <= cur.hi) {
+            auto tw = e.GetElementAtIndex(g - cur.lo);
+            NativeInteger q = tw.GetModulus();
+            NativeInteger prodA(1);
+            for (uint32_t a : added)
+                prodA.ModMulEq(NativeInteger(m_chain[a]).Mod(q), q);
+            tw = tw.Times(prodA);
+            towers.push_back(std::move(tw));
+        }
+        else {
+            towers.emplace_back(gparams->GetParams()[g], e.GetFormat(), true);  // zero tower
+        }
+    }
+
+    // divide out the dropped primes one at a time (centered lift, exact division)
+    for (uint32_t d : dropped) {
+        size_t pos = std::find(gidx.begin(), gidx.end(), d) - gidx.begin();
+        auto lastPoly(towers[pos]);
+        lastPoly.SetFormat(Format::COEFFICIENT);
+        NativeInteger dq(m_chain[d]);
+        towers.erase(towers.begin() + pos);
+        gidx.erase(gidx.begin() + pos);
+        for (size_t i = 0; i < towers.size(); ++i) {
+            NativeInteger qi = towers[i].GetModulus();
+            auto tmp         = lastPoly;
+            tmp.SwitchModulus(qi, towers[i].GetRootOfUnity(), 0, 0);
+            if (towers[i].GetFormat() == Format::EVALUATION)
+                tmp.SwitchFormat();
+            towers[i] -= tmp;
+            towers[i] = towers[i].Times(dq.ModInverse(qi));
+        }
+    }
+
+    DCRTPoly out(nxt.params, e.GetFormat(), true);
+    for (size_t i = 0; i < towers.size(); ++i)
+        out.SetElementAtIndex(i, towers[i]);
+    return out;
+}
+
+void RRChain::RescaleInPlace(Ciphertext<DCRTPoly>& ct) const {
+    uint32_t r = NumLevels() - 1 - ct->GetLevel();
+    auto& cv   = ct->GetElements();
+    for (auto& c : cv)
+        c = RescaleElement(c, r);
+    ct->SetLevel(ct->GetLevel() + 1);
+    ct->SetNoiseScaleDeg(ct->GetNoiseScaleDeg() - 1);
+    ct->SetScalingFactor(ct->GetScalingFactor() / RescaleFactor(r));
+}
+
+Plaintext RRChain::MakePlaintext(const std::vector<std::complex<double>>& value, uint32_t r, double scale,
+                                 size_t noiseScaleDeg, uint32_t slots) const {
+    const auto cryptoParams = std::dynamic_pointer_cast<CryptoParametersCKKSRNS>(m_cc->GetCryptoParameters());
+    if (slots == 0)
+        slots = m_cc->GetEncodingParams()->GetBatchSize();
+    uint32_t level = NumLevels() - 1 - r;
+    auto p = Plaintext(std::make_shared<CKKSPackedEncoding>(Level(r).params, m_cc->GetEncodingParams(), value,
+                                                            noiseScaleDeg, level, scale, slots,
+                                                            m_cc->GetCKKSDataType()));
+    p->Encode();
+    p->GetElement<DCRTPoly>().SetFormat(Format::EVALUATION);
+    p->SetScalingFactor(scale);
+    return p;
+}
+
+Ciphertext<DCRTPoly> RRChain::Encrypt(const PublicKey<DCRTPoly>& pk, const Plaintext& pt, uint32_t r) const {
+    const auto cryptoParams = std::dynamic_pointer_cast<CryptoParametersRNS>(pk->GetCryptoParameters());
+    const auto& pkv         = pk->GetPublicElements();
+    const auto ns           = cryptoParams->GetNoiseScale();
+    const auto& dgg         = cryptoParams->GetDiscreteGaussianGenerator();
+    typename DCRTPoly::TugType tug;
+
+    const auto& params = Level(r).params;
+    DCRTPoly v = cryptoParams->GetSecretKeyDist() == GAUSSIAN ? DCRTPoly(dgg, params, Format::EVALUATION) :
+                                                                DCRTPoly(tug, params, Format::EVALUATION);
+    DCRTPoly e0(dgg, params, Format::EVALUATION);
+    DCRTPoly e1(dgg, params, Format::EVALUATION);
+
+    DCRTPoly p0 = Restrict(pkv[0], r);
+    DCRTPoly p1 = Restrict(pkv[1], r);
+
+    DCRTPoly m = pt->GetElement<DCRTPoly>();
+    m.SetFormat(Format::EVALUATION);
+
+    DCRTPoly c0 = p0 * v + ns * e0 + m;
+    DCRTPoly c1 = p1 * v + ns * e1;
+
+    Ciphertext<DCRTPoly> ct = std::make_shared<CiphertextImpl<DCRTPoly>>(m_cc);
+    ct->SetElements({std::move(c0), std::move(c1)});
+    ct->SetEncodingType(CKKS_PACKED_ENCODING);
+    ct->SetLevel(NumLevels() - 1 - r);
+    ct->SetNoiseScaleDeg(pt->GetNoiseScaleDeg());
+    ct->SetScalingFactor(pt->GetScalingFactor());
+    ct->SetSlots(pt->GetSlots());
+    ct->SetKeyTag(pk->GetKeyTag());
+    return ct;
+}
+
+Plaintext RRChain::Decrypt(const PrivateKey<DCRTPoly>& sk, ConstCiphertext<DCRTPoly>& ct) const {
+    uint32_t r      = NumLevels() - 1 - ct->GetLevel();
+    const auto& cv  = ct->GetElements();
+    DCRTPoly s      = Restrict(sk->GetPrivateElement(), r);
+    DCRTPoly b      = cv[0];
+    DCRTPoly powerS = s;
+    for (size_t i = 1; i < cv.size(); ++i) {
+        b += cv[i] * powerS;
+        if (i + 1 < cv.size())
+            powerS *= s;
+    }
+    b.SetFormat(Format::COEFFICIENT);
+
+    const auto ep = m_cc->GetEncodingParams();
+    auto vp = std::make_shared<typename Poly::Params>(Level(r).params->GetCyclotomicOrder(), ep->GetPlaintextModulus(),
+                                                      1);
+    Plaintext decrypted =
+        PlaintextFactory::MakePlaintext(CKKS_PACKED_ENCODING, vp, ep, INVALID_SCHEME, m_cc->GetCKKSDataType());
+    decrypted->GetElement<Poly>() = (b.GetParams()->GetParams().size() > 1) ?
+                                        b.CRTInterpolate() :
+                                        Poly(b.GetElementAtIndex(0), Format::COEFFICIENT);
+
+    auto decryptedCKKS = std::dynamic_pointer_cast<CKKSPackedEncoding>(decrypted);
+    decryptedCKKS->SetNoiseScaleDeg(ct->GetNoiseScaleDeg());
+    decryptedCKKS->SetLevel(ct->GetLevel());
+    decryptedCKKS->SetScalingFactor(ct->GetScalingFactor());
+    decryptedCKKS->SetSlots(ct->GetSlots());
+    const auto cryptoParamsCKKS = std::dynamic_pointer_cast<CryptoParametersCKKSRNS>(m_cc->GetCryptoParameters());
+    decryptedCKKS->Decode(ct->GetNoiseScaleDeg(), ct->GetScalingFactor(), cryptoParamsCKKS->GetScalingTechnique(),
+                          cryptoParamsCKKS->GetExecutionMode());
+    return decrypted;
+}
+
+void RRChain::EvalMultPlainInPlace(Ciphertext<DCRTPoly>& ct, const Plaintext& pt) const {
+    DCRTPoly m = pt->GetElement<DCRTPoly>();
+    m.SetFormat(Format::EVALUATION);
+    for (auto& c : ct->GetElements())
+        c *= m;
+    ct->SetNoiseScaleDeg(ct->GetNoiseScaleDeg() + pt->GetNoiseScaleDeg());
+    ct->SetScalingFactor(ct->GetScalingFactor() * pt->GetScalingFactor());
+}
+
+void RRChain::EvalAddInPlace(Ciphertext<DCRTPoly>& ct1, ConstCiphertext<DCRTPoly>& ct2) const {
+    const auto& cv2 = ct2->GetElements();
+    auto& cv1       = ct1->GetElements();
+    for (size_t i = 0; i < cv1.size(); ++i)
+        cv1[i] += cv2[i];
+}
+
+}  // namespace lbcrypto
