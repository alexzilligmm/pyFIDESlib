+
+void RRChain::DropToLevelInPlace(Ciphertext<DCRTPoly>& ct, uint32_t rTo) const {
+    const uint32_t rFrom = NumLevels() - 1 - ct->GetLevel();
+    if (rFrom == rTo)
+        return;
+    if (rTo > rFrom)
+        OPENFHE_THROW("RRChain::DropToLevelInPlace: cannot move UP (" + std::to_string(rFrom) + " -> " +
+                      std::to_string(rTo) + ")");
+    const auto& from = Level(rFrom);
+    const auto& to   = Level(rTo);
+    if (!CanDropTo(rFrom, rTo))
+        OPENFHE_THROW("RRChain::DropToLevelInPlace: window [" + std::to_string(to.lo) + "," +
+                      std::to_string(to.hi) + "] is NOT contained in [" + std::to_string(from.lo) + "," +
+                      std::to_string(from.hi) + "], so no set of primes can be discarded to reach it — "
+                      "descend by rescaling instead");
+
+    std::vector<DCRTPoly> out;
+    out.reserve(ct->GetElements().size());
+    for (const auto& e : ct->GetElements()) {
+        DCRTPoly r(to.params, e.GetFormat(), true);
+        for (uint32_t i = to.lo; i <= to.hi; ++i)
+            r.SetElementAtIndex(i - to.lo, e.GetElementAtIndex(i - from.lo));
+        out.push_back(std::move(r));
+    }
+    ct->SetElements(std::move(out));
+    ct->SetLevel(NumLevels() - 1 - rTo);  // the SCALE is unchanged: a drop is not a rescale
+}
