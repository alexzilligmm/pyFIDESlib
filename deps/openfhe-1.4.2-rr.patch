     uint32_t numLargeDigits;
 
@@ -338,6 +349,15 @@ public:
     const std::vector<uint32_t>& GetScalingModSizePerLevel() const {
         return scalingModSizePerLevel;
     }
+    const std::vector<uint64_t>& GetRRPrimeChain() const {
+        return rrPrimeChain;
+    }
+    const std::vector<uint32_t>& GetRRWindows() const {
+        return rrWindows;
+    }
+    uint32_t GetRRNumSmalls() const {
+        return rrNumSmalls;
+    }
     SecurityLevel GetSecurityLevel() const {
         return securityLevel;
     }
@@ -440,6 +460,15 @@ public:
     virtual void SetScalingModSizePerLevel(std::vector<uint32_t> scalingModSizePerLevel0) {
         scalingModSizePerLevel = std::move(scalingModSizePerLevel0);
     }
+    virtual void SetRRPrimeChain(std::vector<uint64_t> rrPrimeChain0) {
+        rrPrimeChain = std::move(rrPrimeChain0);
