+const RRChain::RRLevelKS& RRChain::LevelKS(uint32_t r) const {
+    if (m_ks.empty())
+        m_ks.resize(NumLevels());
+    if (m_ks[r])
+        return *m_ks[r];
+
+    const auto cryptoParams = std::dynamic_pointer_cast<CryptoParametersRNS>(m_cc->GetCryptoParameters());
+    const auto& lvl         = Level(r);
+    const auto paramsP      = cryptoParams->GetParamsP();
+    const auto gparams      = cryptoParams->GetElementParams();
+    uint32_t sizeW          = lvl.hi - lvl.lo + 1;
+    uint32_t sizeP          = paramsP->GetParams().size();
+    uint32_t alpha          = cryptoParams->GetNumPerPartQ();
+
+    auto ks = std::make_unique<RRLevelKS>();
+
+    {  // window ++ P params
+        std::vector<std::shared_ptr<ILNativeParams>> qp = gparams->GetParamPartition(lvl.lo, lvl.hi);
+        for (uint32_t j = 0; j < sizeP; ++j)
+            qp.push_back(paramsP->GetParams()[j]);
+        ks->paramsWP = std::make_shared<DCRTPoly::Params>(gparams->GetCyclotomicOrder(), qp);
+    }
+
+    // window-relaid P tables (globals are indexed by absolute chain position)
+    ks->PInvModq.resize(sizeW);
+    ks->PInvModqPrecon.resize(sizeW);
+    ks->muQ.assign(sizeW, 0);
+    ks->PHatModq.resize(sizeP);
+    for (uint32_t jP = 0; jP < sizeP; ++jP)
+        ks->PHatModq[jP].resize(sizeW);
+    for (uint32_t i = 0; i < sizeW; ++i) {
+        uint32_t g          = lvl.lo + i;
+        ks->PInvModq[i]       = cryptoParams->GetPInvModq()[g];
+        ks->PInvModqPrecon[i] = cryptoParams->GetPInvModqPrecon()[g];
+        for (uint32_t jP = 0; jP < sizeP; ++jP)
+            ks->PHatModq[jP][i] = cryptoParams->GetPHatModq()[jP][g];
+    }
+
+    // digits: window ∩ global partition, contiguous
+    for (uint32_t part = lvl.lo / alpha; part <= lvl.hi / alpha; ++part) {
+        RRDigitKS dg;
+        dg.gLo = std::max(lvl.lo, part * alpha);
+        dg.gHi = std::min(lvl.hi, (part + 1) * alpha - 1);
+        dg.paramsD =
+            std::make_shared<DCRTPoly::Params>(gparams->GetCyclotomicOrder(), gparams->GetParamPartition(dg.gLo, dg.gHi));
+        {  // (window \ digit) ++ P — the ApproxSwitchCRTBasis target
+            std::vector<std::shared_ptr<ILNativeParams>> cp;
+            for (uint32_t g = lvl.lo; g <= lvl.hi; ++g)
+                if (g < dg.gLo || g > dg.gHi)
+                    cp.push_back(gparams->GetParams()[g]);
+            for (uint32_t j = 0; j < sizeP; ++j)
+                cp.push_back(paramsP->GetParams()[j]);
+            dg.paramsCompl = std::make_shared<DCRTPoly::Params>(gparams->GetCyclotomicOrder(), cp);
+        }
+        uint32_t sizeD = dg.gHi - dg.gLo + 1;
+        dg.DHatInvModd.resize(sizeD);
+        dg.DHatInvModdPrecon.resize(sizeD);
+        dg.DHatModt.resize(sizeD);
+        dg.muT.assign(dg.paramsCompl->GetParams().size(), 0);
+        BigInteger D(1);
+        for (uint32_t i = 0; i < sizeD; ++i)
+            D = D * BigInteger(m_chain[dg.gLo + i]);
+        for (uint32_t i = 0; i < sizeD; ++i) {
+            NativeInteger di(m_chain[dg.gLo + i]);
+            BigInteger DHat        = D / BigInteger(di);
+            dg.DHatInvModd[i]      = DHat.Mod(BigInteger(di)).ConvertToInt<BasicInteger>();
+            dg.DHatInvModd[i]      = dg.DHatInvModd[i].ModInverse(di);
+            dg.DHatInvModdPrecon[i] = dg.DHatInvModd[i].PrepModMulConst(di);
+            dg.DHatModt[i].resize(dg.paramsCompl->GetParams().size());
+            for (size_t jT = 0; jT < dg.paramsCompl->GetParams().size(); ++jT) {
+                const auto& t      = dg.paramsCompl->GetParams()[jT]->GetModulus();
+                dg.DHatModt[i][jT] = DHat.Mod(BigInteger(t)).ConvertToInt<BasicInteger>();
+            }
+        }
+        ks->digits.push_back(std::move(dg));
+    }
+
+    m_ks[r] = std::move(ks);
+    return *m_ks[r];
+}
+
+std::pair<DCRTPoly, DCRTPoly> RRChain::KeySwitchCore(const DCRTPoly& c, const EvalKey<DCRTPoly>& evk,
+                                                     uint32_t r) const {
+    const auto cryptoParams = std::dynamic_pointer_cast<CryptoParametersRNS>(m_cc->GetCryptoParameters());
+    const auto& lvl         = Level(r);
+    const auto& ks          = LevelKS(r);
+    uint32_t sizeW          = lvl.hi - lvl.lo + 1;
+    uint32_t sizeQglobal    = cryptoParams->GetElementParams()->GetParams().size();
+    uint32_t sizeP          = cryptoParams->GetParamsP()->GetParams().size();
+    uint32_t sizeWP         = sizeW + sizeP;
+
+    const auto& av = evk->GetAVector();
+    const auto& bv = evk->GetBVector();
+
+    DCRTPoly cTilda0(ks.paramsWP, Format::EVALUATION, true);
+    DCRTPoly cTilda1(ks.paramsWP, Format::EVALUATION, true);
+
+    for (size_t dj = 0; dj < ks.digits.size(); ++dj) {
+        const auto& dg = ks.digits[dj];
+        uint32_t part  = dg.gLo / cryptoParams->GetNumPerPartQ();
+        uint32_t sizeD = dg.gHi - dg.gLo + 1;
+
+        // digit slice (window-local) and its base conversion onto (window\digit) ++ P
+        DCRTPoly cPart(dg.paramsD, Format::EVALUATION, true);
+        for (uint32_t i = 0; i < sizeD; ++i)
+            cPart.SetElementAtIndex(i, c.GetElementAtIndex(dg.gLo - lvl.lo + i));
+        auto cPartCoef = cPart.Clone();
+        cPartCoef.SetFormat(Format::COEFFICIENT);
+        auto compl_ =
+            cPartCoef.ApproxSwitchCRTBasis(dg.paramsD, dg.paramsCompl, dg.DHatInvModd, dg.DHatInvModdPrecon,
+                                           dg.DHatModt, dg.muT);
+        compl_.SetFormat(Format::EVALUATION);
+
+        // scatter into [window | P] order and dot with the evk rows (global index)
+        uint32_t startLocal = dg.gLo - lvl.lo;
+        uint32_t endLocal   = startLocal + sizeD;
+        for (uint32_t i = 0; i < sizeWP; ++i) {
+            const DCRTPoly::PolyType* digitTower;
+            if (i < startLocal)
+                digitTower = &compl_.GetElementAtIndex(i);
+            else if (i < endLocal)
+                digitTower = &cPart.GetElementAtIndex(i - startLocal);
+            else
+                digitTower = &compl_.GetElementAtIndex(i - sizeD);
+            uint32_t row = (i < sizeW) ? (lvl.lo + i) : (sizeQglobal + (i - sizeW));
+            cTilda0.SetElementAtIndex(i, cTilda0.GetElementAtIndex(i) + *digitTower * bv[part].GetElementAtIndex(row));
+            cTilda1.SetElementAtIndex(i, cTilda1.GetElementAtIndex(i) + *digitTower * av[part].GetElementAtIndex(row));
+        }
+    }
+
+    std::vector<NativeInteger> noVec;
+    DCRTPoly ct0 = cTilda0.ApproxModDown(lvl.params, cryptoParams->GetParamsP(), ks.PInvModq, ks.PInvModqPrecon,
+                                         cryptoParams->GetPHatInvModp(), cryptoParams->GetPHatInvModpPrecon(),
+                                         ks.PHatModq, ks.muQ, noVec, noVec, NativeInteger(0), noVec);
+    DCRTPoly ct1 = cTilda1.ApproxModDown(lvl.params, cryptoParams->GetParamsP(), ks.PInvModq, ks.PInvModqPrecon,
+                                         cryptoParams->GetPHatInvModp(), cryptoParams->GetPHatInvModpPrecon(),
+                                         ks.PHatModq, ks.muQ, noVec, noVec, NativeInteger(0), noVec);
+    return {std::move(ct0), std::move(ct1)};
+}
+
+Ciphertext<DCRTPoly> RRChain::EvalMultRelin(ConstCiphertext<DCRTPoly>& ct1, ConstCiphertext<DCRTPoly>& ct2) const {
+    if (ct1->GetLevel() != ct2->GetLevel())
+        OPENFHE_THROW("RRChain::EvalMultRelin: operands must sit at the same rr level.");
+    uint32_t r      = NumLevels() - 1 - ct1->GetLevel();
+    const auto& cv1 = ct1->GetElements();
+    const auto& cv2 = ct2->GetElements();
+    if (cv1.size() != 2 || cv2.size() != 2)
+        OPENFHE_THROW("RRChain::EvalMultRelin: operands must be degree-1 (2 elements).");
+
+    DCRTPoly c0 = cv1[0] * cv2[0];
+    DCRTPoly c1 = cv1[0] * cv2[1] + cv1[1] * cv2[0];
+    DCRTPoly c2 = cv1[1] * cv2[1];
+
+    const auto evks = m_cc->GetEvalMultKeyVector(ct1->GetKeyTag());
+    auto ab         = KeySwitchCore(c2, evks[0], r);
+    c0 += ab.first;
+    c1 += ab.second;
+
+    Ciphertext<DCRTPoly> out = ct1->Clone();
+    out->SetElements({std::move(c0), std::move(c1)});
+    out->SetNoiseScaleDeg(ct1->GetNoiseScaleDeg() + ct2->GetNoiseScaleDeg());
+    out->SetScalingFactor(ct1->GetScalingFactor() * ct2->GetScalingFactor());
+    return out;
+}
+
 }  // namespace lbcrypto
