+    /** Number of RR levels. An RR level is a WINDOW of the layout, and the level index used
+     *  throughout OpenFHE (m_level) is the RESCALE COUNT from the top, so OpenFHE level l is
+     *  window index nLvl-1-l. Limb count does NOT identify a level: levels drop a variable
+     *  number of limbs and add some back. */
+    uint32_t RRNumLevels() const {
+        return static_cast<uint32_t>(m_rrWindows.size() / 2);
+    }
+    /** Window [lo, hi] of the RR level at OpenFHE level `l` (rescale count from the top). */
+    std::pair<uint32_t, uint32_t> RRWindowAtLevel(uint32_t l) const {
+        if (l >= RRNumLevels())
