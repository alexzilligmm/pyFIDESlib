+                          std::to_string(RRNumLevels()) +
+                          " — a level index computed as a limb/tower count, not an RR level");
+        const uint32_t r = RRNumLevels() - 1 - l;
+        return {m_rrWindows[2 * r], m_rrWindows[2 * r + 1]};
