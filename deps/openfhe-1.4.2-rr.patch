+     *  l -> l+1 (i.e. RR window r -> r-1). This is the RR replacement for
+     *  GetModReduceFactor(numQ-1-level), which is prefix-chain arithmetic and meaningless here. */
+    double RRRescaleFactorAtLevel(uint32_t l) const {
+        const uint32_t nLvl = RRNumLevels();
+        const uint32_t r    = nLvl - 1 - l;          // window index of the SOURCE level
+        const uint32_t hLo = m_rrWindows[2 * r], hHi = m_rrWindows[2 * r + 1];
