 protected:
     // Optional per-level bit sizes for the rescale primes q_1..q_n (bottom-up).
     // Empty = uniform chain. See CCParams::scalingModSizePerLevel.
     std::vector<uint32_t> m_scalingModSizePerLevel;
 
+    // Rational-rescaling chain state (see CCParams::rrPrimeChain).
+    std::vector<uint64_t> m_rrPrimeChain;
+    std::vector<uint32_t> m_rrWindows;
+    uint32_t m_rrNumSmalls = 0;
