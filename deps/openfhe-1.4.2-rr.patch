@@ -124,6 +124,43 @@ bool ParameterGenerationCKKSRNS::ParamsGenCKKSRNSInternal(std::shared_ptr<Crypto
         }
     }
 
+    // Rational-rescaling chain: explicit prime identities + per-level windows.
+    const std::vector<uint64_t>& rrChain = cryptoParamsCKKSRNS->GetRRPrimeChain();
+    if (!rrChain.empty()) {
+        if (scalTech != FLEXIBLEAUTO)
+            OPENFHE_THROW("rrPrimeChain requires FLEXIBLEAUTO.");
+        if (!sizesPerLevel.empty())
+            OPENFHE_THROW("rrPrimeChain and scalingModSizePerLevel are mutually exclusive.");
+        if (rrChain.size() != static_cast<size_t>(numPrimes))
+            OPENFHE_THROW("rrPrimeChain must have multiplicativeDepth+1 (" + std::to_string(numPrimes) +
+                          ") entries, got " + std::to_string(rrChain.size()) + ".");
+        const auto& windows = cryptoParamsCKKSRNS->GetRRWindows();
+        if (windows.size() < 4 || windows.size() % 2 != 0)
+            OPENFHE_THROW("rrWindows must hold >= 2 flattened (lo, hi) pairs.");
+        uint32_t S = cryptoParamsCKKSRNS->GetRRNumSmalls();
+        if (S >= rrChain.size())
+            OPENFHE_THROW("rrNumSmalls out of range.");
+        uint32_t nLvl = windows.size() / 2;
+        if (windows[2 * (nLvl - 1)] != 0 || windows[2 * (nLvl - 1) + 1] != rrChain.size() - 1)
+            OPENFHE_THROW("rrWindows: the top level must span the whole chain.");
+        for (uint32_t r = 0; r < nLvl; ++r) {
+            uint32_t lo = windows[2 * r], hi = windows[2 * r + 1];
+            if (lo > S || hi < S || hi >= rrChain.size())
+                OPENFHE_THROW("rrWindows: every window must contain q0 and stay in range.");
+            if (r > 0 &&
+                (windows[2 * r] > windows[2 * (r - 1)] + 4 || windows[2 * r + 1] + 4 < windows[2 * (r - 1) + 1]))
+                OPENFHE_THROW("rrWindows: adjacent windows must differ by edge moves only.");
+        }
+        if (cyclOrder == 0)
+            OPENFHE_THROW("rrPrimeChain requires an explicit ring dimension.");
+        for (auto m : rrChain) {
+            if (m >= (uint64_t(1) << MAX_MODULUS_SIZE))
+                OPENFHE_THROW("rrPrimeChain modulus exceeds MAX_MODULUS_SIZE.");
+            if (m % cyclOrder != 1)
+                OPENFHE_THROW("rrPrimeChain modulus is not 1 mod 2N.");
+        }
+    }
+
     // TODO: Allow the user to specify this?
     uint32_t extraModSize = (scalTech == FLEXIBLEAUTOEXT) ? DCRT_MODULUS::DEFAULT_EXTRA_MOD_SIZE : 0;
 
@@ -194,7 +231,32 @@ bool ParameterGenerationCKKSRNS::ParamsGenCKKSRNSInternal(std::shared_ptr<Crypto
