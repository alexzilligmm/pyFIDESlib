+    out.assign(slots, std::complex<double>(0.0, 0.0));
+    for (uint32_t i = 0; i < slots; ++i) {
+        const BigInteger& re = big[gap * i];
+        const BigInteger& im = big[gap * i + Nh];
+        const double dre = (re > Mh) ? -((M - re).ConvertToDouble()) : re.ConvertToDouble();
+        const double dim = (im > Mh) ? -((M - im).ConvertToDouble()) : im.ConvertToDouble();
+        out[i] = std::complex<double>(dre / sc, dim / sc);
+    }
+    DiscreteFourierTransform::FFTSpecial(out, N * 2);
+    return true;
+}
