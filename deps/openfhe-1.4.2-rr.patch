+        // but there is no I*q0 lattice there either, so for a ZERO message the centered lift
+        // IS the noise. Fall back to reducing mod Q (a no-op) and say which mode was used.
+        const bool latticed = (Q.Mod(q0) == BigInteger(0)) && (Q > q0);
+        if (!latticed)
+            q0 = Q;
+        const BigInteger q0h = q0 >> 1;
