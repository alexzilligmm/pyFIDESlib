diff --git a/src/pke/lib/scheme/ckksrns/ckksrns-cryptoparameters.cpp b/src/pke/lib/scheme/ckksrns/ckksrns-cryptoparameters.cpp
index b5cd0a27..64cda992 100644
--- a/src/pke/lib/scheme/ckksrns/ckksrns-cryptoparameters.cpp
+++ b/src/pke/lib/scheme/ckksrns/ckksrns-cryptoparameters.cpp
@@ -90,7 +90,41 @@ void CryptoParametersCKKSRNS::PrecomputeCRTTables(KeySwitchTechnique ksTech, Sca
         m_scalTechnique == COMPOSITESCALINGAUTO || m_scalTechnique == COMPOSITESCALINGMANUAL) {
         m_scalingFactorsReal.resize(sizeQ);
 
-        if ((sizeQ == 1) && (extraBits == 0) && (m_scalTechnique != COMPOSITESCALINGAUTO) &&
+        if (IsRRChain()) {
+            // Rational-rescaling chain: the table is indexed by RESCALE COUNT from
+            // the top (that is what RR ciphertexts carry in m_level), not by limbs
+            // dropped — RR levels drop a variable number of limbs and may add some
+            // back, so limb count does not identify a level. sf follows the exact
+            // per-level rescale factors F = prod(dropped)/prod(added); at a region
+            // boundary (bts -> payload) the recursion is reset to the next F, the
+            // jump being absorbed by the boundary ct-pt op (mixedlimb convention).
+            const auto& win = m_rrWindows;
+            size_t nLvl     = win.size() / 2;
+            std::vector<double> F(nLvl - 1);
+            for (size_t k = 0; k + 1 < nLvl; ++k) {
+                size_t hiL = nLvl - 1 - k, loL = hiL - 1;  // rr levels: from (top - k) down
+                uint32_t hLo = win[2 * hiL], hHi = win[2 * hiL + 1];
+                uint32_t lLo = win[2 * loL], lHi = win[2 * loL + 1];
+                double f = 1.0;
+                for (uint32_t i = std::min(hLo, lLo); i < std::max(hLo, lLo); ++i)
+                    f = (hLo < lLo) ? f * static_cast<double>(m_rrPrimeChain[i]) :
+                                      f / static_cast<double>(m_rrPrimeChain[i]);
+                for (uint32_t i = std::min(hHi, lHi) + 1; i <= std::max(hHi, lHi); ++i)
+                    f = (hHi > lHi) ? f * static_cast<double>(m_rrPrimeChain[i]) :
+                                      f / static_cast<double>(m_rrPrimeChain[i]);
+                F[k] = f;
+            }
+            m_scalingFactorsReal[0] = F[0];
+            for (size_t k = 1; k < nLvl; ++k) {
+                double cand = m_scalingFactorsReal[k - 1] * m_scalingFactorsReal[k - 1] / F[k - 1];
+                if (k < nLvl - 1 && std::fabs(std::log2(cand) - std::log2(F[k])) > 1.5)
+                    cand = F[k];  // region boundary reset
+                m_scalingFactorsReal[k] = cand;
+            }
+            for (size_t k = nLvl; k < sizeQ; ++k)
+                m_scalingFactorsReal[k] = 1;  // holes, composite-style
+        }
+        else if ((sizeQ == 1) && (extraBits == 0) && (m_scalTechnique != COMPOSITESCALINGAUTO) &&
             (m_scalTechnique != COMPOSITESCALINGMANUAL)) {
             // mult depth = 0 and FLEXIBLEAUTO
             // when multiplicative depth = 0, we use the scaling mod size instead of modulus size
diff --git a/src/pke/lib/scheme/ckksrns/ckksrns-parametergeneration.cpp b/src/pke/lib/scheme/ckksrns/ckksrns-parametergeneration.cpp
