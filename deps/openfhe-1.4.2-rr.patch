+const RRChain& GetRRChain(const CryptoContext<DCRTPoly>& cc) {
+    static std::mutex mtx;
+    static std::map<const void*, std::unique_ptr<RRChain>> cache;
+    const void* key = static_cast<const void*>(cc->GetCryptoParameters().get());
