+                  << (mag > 0 && bestErr > 0 ? -std::log2(bestErr / mag) : 99.0) << " bits  (|v|max=" << mag
+                  << ", scale 2^" << std::log2(in->GetScalingFactor()) << ")\n";
+    } catch (const std::exception& e) {
+        std::cerr << "[rr_rotchk] " << tag << " <" << e.what() << ">\n";
+    }
+}
+
+// RR_AUX_SELFTEST=1: MakeAuxPlaintext's OWN precision, measured alone.
+//
+// This is the last component of CoeffsToSlots never measured in isolation. It is a DIFFERENT
+// encoder from the one `rr_op_precision` cleared (CKKSPackedEncoding): its own logApprox
+// scale-down path, its own NATIVEINT=32 FitToNativeVector. Every other CtS suspect is excluded.
+//
+// The measurement takes no decode and no ciphertext, so nothing else can contaminate it:
+// MakeAuxPlaintext computes `inverse = FFTSpecialInv(value)` and then rounds
+// `inverse[i]*scFact` into the polynomial's coefficients, so recomputing that on the host and
+// diffing the INTEGER coefficients reads the encoder's error directly. Reported relative to the
+// largest coefficient, which is the scale the ciphertext product actually sees.
+static double rrAuxEncodeBits(const Plaintext& p, const std::vector<std::complex<double>>& value,
+                              uint32_t slots) {
+    DCRTPoly e = p->GetElement<DCRTPoly>();
+    e.SetFormat(COEFFICIENT);
+    const auto big      = e.CRTInterpolate();
+    const BigInteger M  = e.GetModulus();
+    const BigInteger Mh = M >> 1;
+    const uint32_t N    = e.GetRingDimension();
+    const uint32_t Nh   = N / 2;
+    const uint32_t gap  = Nh / slots;
+    const double scFact = p->GetScalingFactor();
+
+    std::vector<std::complex<double>> inv(value);
+    inv.resize(slots);
+    DiscreteFourierTransform::FFTSpecialInv(inv, N * 2);
+
+    auto centered = [&](const BigInteger& v) -> double {
+        return (v > Mh) ? -((M - v).ConvertToDouble()) : v.ConvertToDouble();
+    };
+
+    double err = 0.0, mag = 0.0;
+    for (uint32_t i = 0; i < slots; ++i) {
+        const double wantRe = inv[i].real() * scFact;
+        const double wantIm = inv[i].imag() * scFact;
+        err = std::max(err, std::fabs(centered(big[gap * i]) - wantRe));
+        err = std::max(err, std::fabs(centered(big[gap * i + Nh]) - wantIm));
+        mag = std::max(mag, std::max(std::fabs(wantRe), std::fabs(wantIm)));
+    }
+    return (err > 0 && mag > 0) ? -std::log2(err / mag) : 99.0;
+}
