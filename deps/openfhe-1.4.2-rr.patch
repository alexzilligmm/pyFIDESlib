+        const usint n = b.GetRingDimension();
+        double mx = 0.0, ss = 0.0;
+        for (usint i = 0; i < n; ++i) {
+            const BigInteger& v = big[i];
+            BigInteger mag      = (v > Qh) ? (Q - v) : v;
+            BigInteger r        = mag.Mod(q0);
+            if (r > q0h)
+                r = q0 - r;
+            const double d = r.ConvertToDouble();
+            mx             = std::max(mx, d);
+            ss += d * d;
+        }
