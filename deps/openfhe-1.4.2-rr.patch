--- a/src/pke/include/scheme/ckksrns/ckksrns-rr.h
+++ b/src/pke/include/scheme/ckksrns/ckksrns-rr.h
@@ -64,12 +64,39 @@ public:
     void EvalMultPlainInPlace(Ciphertext<DCRTPoly>& ct, const Plaintext& pt) const;
     void EvalAddInPlace(Ciphertext<DCRTPoly>& ct1, ConstCiphertext<DCRTPoly>& ct2) const;
 
+    // HYBRID keyswitch against the single evk at P*Qmax, truncated to the
+    // level's window: digits = window ∩ global partition (contiguous by
+    // construction), evk rows read positionally by global index. Returns the
+    // (b, a) contribution already ModDown'ed back to the window basis.
+    std::pair<DCRTPoly, DCRTPoly> KeySwitchCore(const DCRTPoly& c, const EvalKey<DCRTPoly>& evk, uint32_t r) const;
+
+    // ct x ct product with relinearization (both at the same rr level, deg 1)
+    Ciphertext<DCRTPoly> EvalMultRelin(ConstCiphertext<DCRTPoly>& ct1, ConstCiphertext<DCRTPoly>& ct2) const;
+
 private:
+    struct RRDigitKS {
+        uint32_t gLo, gHi;                          // global index range of the digit
+        std::shared_ptr<DCRTPoly::Params> paramsD;  // digit base
+        std::shared_ptr<DCRTPoly::Params> paramsCompl;  // (window \ digit) ++ P
+        std::vector<NativeInteger> DHatInvModd, DHatInvModdPrecon;
+        std::vector<std::vector<NativeInteger>> DHatModt;
+        std::vector<DoubleNativeInt> muT;  // unused on the 32-bit path, zeros
+    };
+    struct RRLevelKS {
+        std::shared_ptr<DCRTPoly::Params> paramsWP;  // window ++ P
+        std::vector<RRDigitKS> digits;
+        std::vector<NativeInteger> PInvModq, PInvModqPrecon;
+        std::vector<std::vector<NativeInteger>> PHatModq;
+        std::vector<DoubleNativeInt> muQ;
+    };
+    const RRLevelKS& LevelKS(uint32_t r) const;
+
     CryptoContext<DCRTPoly> m_cc;
     std::vector<uint64_t> m_chain;
     uint32_t m_S = 0;
     std::vector<RRLevel> m_levels;
     std::vector<double> m_F;  // m_F[r-1] = rescale factor r -> r-1
+    mutable std::vector<std::unique_ptr<RRLevelKS>> m_ks;  // lazy per-level cache
 };
 
 }  // namespace lbcrypto
diff --git a/src/pke/lib/scheme/ckksrns/ckksrns-rr.cpp b/src/pke/lib/scheme/ckksrns/ckksrns-rr.cpp
index 6771543d..88faec26 100644
